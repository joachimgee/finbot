# FINBOT PRODUCTION ENVIRONMENT
# Copy to .env.production and fill with your REAL API keys

# Alpaca (PRODUCTION)
# Get FREE paper trading keys at: https://alpaca.markets/
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_PAPER=true  # Start with paper trading (SAFE)

# NewsAPI (REAL news)
# Get FREE key at: https://newsapi.org/ (500 requests/day)
NEWS_API_KEY=your_newsapi_key_here

# Alpha Vantage (Optional - additional market data)
# Get FREE key at: https://www.alphavantage.co/
ALPHA_VANTAGE_API_KEY=your_alphavantage_key_here

# Database (PRODUCTION)
DATABASE_URL=postgresql://user:pass@localhost:5432/finbot

# Redis (PRODUCTION cache)
REDIS_URL=redis://localhost:6379/0

# Monitoring
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true
LOG_LEVEL=INFO

# Risk Management
MAX_POSITION_SIZE=0.20  # 20% max per position
MAX_PORTFOLIO_RISK=0.02  # 2% max portfolio risk
STOP_LOSS_PCT=0.05  # 5% stop loss
TAKE_PROFIT_PCT=0.15  # 15% take profit

# Trading Schedule (US market hours)
TRADING_START_HOUR=9  # 9:30 AM ET
TRADING_END_HOUR=16   # 4:00 PM ET
TIMEZONE=America/New_York

# Rebalancing
REBALANCE_FREQUENCY=weekly  # daily, weekly, monthly
MIN_REBALANCE_THRESHOLD=0.05  # 5% drift before rebalance

# Universe Selection
DEFAULT_SECTOR=Technology
DEFAULT_N_ASSETS=10
MIN_MARKET_CAP=1000000000  # $1B minimum

# Backtesting
BACKTEST_START_DATE=2024-01-01
BACKTEST_END_DATE=2025-11-12
INITIAL_CAPITAL=100000  # $100k initial capital

# Notifications
ENABLE_EMAIL_ALERTS=false
ENABLE_SMS_ALERTS=false
EMAIL_RECIPIENTS=your@email.com
SMS_RECIPIENTS=+1234567890

# ============================================================================
# FinBot Environment Configuration
# ============================================================================
# IMPORTANT: Copy this file to .env and update all passwords/secrets!
# DO NOT commit .env to version control!
# ============================================================================

# ============================================================================
# APPLICATION CONFIG
# ============================================================================

# Environment: development, staging, production
ENVIRONMENT=production

# Debug mode (NEVER enable in production!)
DEBUG=False

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format: json, text
LOG_FORMAT=json

# ============================================================================
# DATABASE CONFIG (PostgreSQL)
# ============================================================================

# Full database URL
DATABASE_URL=postgresql+psycopg2://finbot:finbot_secure_pwd@postgres:5432/finbot_db

# Connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_ECHO=False

# ============================================================================
# CACHE CONFIG (Redis)
# ============================================================================

# Redis connection URL
REDIS_URL=redis://:finbot_redis_pwd@redis:6379/0

# Redis timeouts (seconds)
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_MAX_CONNECTIONS=50

# Cache TTL (seconds)
CACHE_TTL_SHORT=300
CACHE_TTL_MEDIUM=3600
CACHE_TTL_LONG=86400

# ============================================================================
# API CONFIG
# ============================================================================

# API server settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_TIMEOUT=120
API_KEEP_ALIVE=5
API_GRACEFUL_TIMEOUT=30

# CORS settings (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,https://finbot.ai
CORS_ALLOW_CREDENTIALS=True

# Rate limiting (requests per minute)
RATE_LIMIT_API=600
RATE_LIMIT_BACKTEST=60

# ============================================================================
# SECRETS (⚠️ CHANGE IN PRODUCTION!)
# ============================================================================

# PostgreSQL password (⚠️ CHANGE THIS!)
POSTGRES_PASSWORD=finbot_secure_pwd

# Redis password (⚠️ CHANGE THIS!)
REDIS_PASSWORD=finbot_redis_pwd

# Application secret key (⚠️ CHANGE THIS!)
SECRET_KEY=your-secret-key-change-in-production

# JWT settings
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable/disable major features
ENABLE_SENTIMENT_ANALYSIS=true
ENABLE_ML_PREDICTIONS=true
ENABLE_BACKTESTING=true
ENABLE_WALK_FORWARD=true
ENABLE_PORTFOLIO_OPTIMIZATION=true
ENABLE_LIVE_TRADING=false

# ============================================================================
# EXTERNAL APIS (Optional)
# ============================================================================

# News API for sentiment analysis
NEWSAPI_KEY=your-newsapi-key-here

# Yahoo Finance (if using premium API)
YFINANCE_API_KEY=your-yfinance-key-here

# Alpha Vantage
ALPHAVANTAGE_API_KEY=your-alphavantage-key-here

# ============================================================================
# BACKTESTING CONFIG
# ============================================================================

# Default backtesting parameters
BACKTEST_DEFAULT_CASH=100000
BACKTEST_DEFAULT_COMMISSION=0.001
BACKTEST_MAX_WORKERS=4

# ============================================================================
# ML CONFIG
# ============================================================================

# Model paths
ML_MODEL_DIR=/app/models
ML_CHECKPOINT_DIR=/app/checkpoints

# Training settings
ML_BATCH_SIZE=32
ML_EPOCHS=100
ML_LEARNING_RATE=0.001

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================

# Metrics export
ENABLE_METRICS=true
METRICS_PORT=9090

# Sentry (error tracking)
SENTRY_DSN=your-sentry-dsn-here
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================================================
# SECURITY
# ============================================================================

# SSL/TLS
SSL_ENABLED=false
SSL_CERT_PATH=/app/ssl/cert.pem
SSL_KEY_PATH=/app/ssl/key.pem

# Security headers
ENABLE_SECURITY_HEADERS=true
ENABLE_HSTS=true
HSTS_MAX_AGE=31536000

# ============================================================================
# PERFORMANCE
# ============================================================================

# Worker settings
WORKER_CLASS=uvicorn.workers.UvicornWorker
WORKER_CONNECTIONS=1000
WORKER_MAX_REQUESTS=10000
WORKER_MAX_REQUESTS_JITTER=100

# ============================================================================
# DATA STORAGE
# ============================================================================

# Local data paths
DATA_DIR=/app/data
LOG_DIR=/app/logs
CONFIG_DIR=/app/config

# Data retention (days)
DATA_RETENTION_DAYS=90
LOG_RETENTION_DAYS=30

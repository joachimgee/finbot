# ============================================================================
# FinBot v2.0 - Environment Variables Template
# ============================================================================
# 
# Instructions:
# 1. Copier ce fichier vers .env : cp .env.example .env
# 2. Remplacer les valeurs par vos vraies clés API
# 3. Ne JAMAIS committer le fichier .env (déjà dans .gitignore)
#
# ============================================================================

# ============================================================================
# API KEYS - Market Data Providers
# ============================================================================

# Financial Modeling Prep (FMP) - Données fondamentales et ratios
# Inscription: https://site.financialmodelingprep.com/developer/docs
# Plan gratuit: 250 requêtes/jour
FMP_API_KEY=your_financial_modeling_prep_api_key_here

# Alpha Vantage - Données historiques et indicateurs techniques
# Inscription: https://www.alphavantage.co/support/#api-key
# Plan gratuit: 5 requêtes/minute, 500 requêtes/jour
ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here

# Polygon.io - Données temps réel et historiques
# Inscription: https://polygon.io/
# Plan gratuit: 5 requêtes/minute
POLYGON_API_KEY=your_polygon_api_key_here

# Yahoo Finance (yfinance) - Pas de clé requise
# Utilisé comme fallback pour données OHLCV gratuites

# IEX Cloud - Données financières additionnelles (optionnel)
# Inscription: https://iexcloud.io/
# IEX_API_KEY=your_iex_cloud_api_key_here

# Quandl/Nasdaq Data Link - Données économiques (optionnel)
# Inscription: https://data.nasdaq.com/
# QUANDL_API_KEY=your_quandl_api_key_here

# ============================================================================
# API KEYS - Alternative Data
# ============================================================================

# News API - Actualités financières
# Inscription: https://newsapi.org/
# Plan gratuit: 100 requêtes/jour
NEWS_API_KEY=your_newsapi_key_here

# Alpha Vantage News Sentiment (utilise même clé que ci-dessus)
# Sentiment analysis sur actualités financières

# Twitter/X API - Sentiment social media (optionnel)
# Inscription: https://developer.twitter.com/
# TWITTER_API_KEY=your_twitter_api_key_here
# TWITTER_API_SECRET=your_twitter_api_secret_here
# TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# Reddit API - Sentiment WSB et communautés finance (optionnel)
# Inscription: https://www.reddit.com/prefs/apps
# REDDIT_CLIENT_ID=your_reddit_client_id_here
# REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
# REDDIT_USER_AGENT=FinBot/1.0

# ============================================================================
# API KEYS - AI/ML Services
# ============================================================================

# OpenAI - GPT pour analyse textuelle avancée (optionnel)
# Inscription: https://platform.openai.com/
# OPENAI_API_KEY=your_openai_api_key_here

# Hugging Face - Modèles NLP (FinBERT sentiment)
# Inscription: https://huggingface.co/settings/tokens
# Token optionnel pour modèles privés ou rate limits élevés
# HUGGINGFACE_TOKEN=your_huggingface_token_here

# ============================================================================
# CACHE CONFIGURATION
# ============================================================================

# Backend de cache: 'disk' (local) ou 'redis' (serveur)
CACHE_BACKEND=disk

# Time-to-Live du cache en secondes (3600 = 1 heure)
CACHE_TTL=3600

# Répertoire cache disque (si CACHE_BACKEND=disk)
CACHE_DIR=.cache

# Redis URL (si CACHE_BACKEND=redis)
# Format: redis://[username:password@]host:port/db_number
REDIS_URL=redis://localhost:6379/0

# Redis password (si authentification requise)
# REDIS_PASSWORD=your_redis_password_here

# ============================================================================
# DATABASE CONFIGURATION (Optionnel - pour production)
# ============================================================================

# PostgreSQL - Stockage données historiques
# DATABASE_URL=postgresql://user:password@localhost:5432/finbot

# MongoDB - Stockage documents (news, sentiment)
# MONGODB_URL=mongodb://localhost:27017/finbot

# SQLite - Base de données locale (par défaut)
DATABASE_URL=sqlite:///./finbot.db

# InfluxDB - Stockage time series (optionnel)
# INFLUXDB_URL=http://localhost:8086
# INFLUXDB_TOKEN=your_influxdb_token_here
# INFLUXDB_ORG=your_org
# INFLUXDB_BUCKET=finbot

# ============================================================================
# TRADING CONFIGURATION
# ============================================================================

# Capital initial pour backtests (en USD)
INITIAL_CAPITAL=10000

# Commission de courtage (0.002 = 0.2%)
COMMISSION_RATE=0.002

# Slippage en basis points (5 = 0.05%)
SLIPPAGE_BPS=5

# Taux sans risque annuel (0.02 = 2%)
# Utilisé pour calcul Sharpe ratio
RISK_FREE_RATE=0.02

# Devise de compte par défaut
BASE_CURRENCY=USD

# ============================================================================
# PORTFOLIO CONFIGURATION
# ============================================================================

# Méthode d'optimisation par défaut
# Options: 'mean_variance', 'hrp', 'black_litterman', 'cvar', 'equal_weight'
DEFAULT_OPTIMIZER=mean_variance

# Objectif d'optimisation
# Options: 'max_sharpe', 'min_volatility', 'max_return', 'efficient_risk'
OPTIMIZATION_OBJECTIVE=max_sharpe

# Contraintes de poids (0.0 à 1.0)
MIN_WEIGHT=0.0
MAX_WEIGHT=0.4

# Autoriser short selling (True/False)
ALLOW_SHORT=False

# ============================================================================
# RISK MANAGEMENT
# ============================================================================

# Value at Risk (VaR) - Niveau de confiance (0.05 = 95%)
VAR_ALPHA=0.05

# Maximum drawdown accepté (0.20 = 20%)
MAX_DRAWDOWN_THRESHOLD=0.20

# Position size maximum par ticker (% du portfolio)
MAX_POSITION_SIZE=0.25

# Stop loss par défaut (% de perte acceptable par trade)
DEFAULT_STOP_LOSS=0.05

# Take profit par défaut (% de gain cible par trade)
DEFAULT_TAKE_PROFIT=0.15

# ============================================================================
# ML CONFIGURATION
# ============================================================================

# Random state pour reproductibilité
ML_RANDOM_STATE=42

# Nombre de splits pour TimeSeriesSplit cross-validation
ML_N_SPLITS=5

# Nombre de CPU cores pour parallel processing (-1 = tous)
ML_N_JOBS=-1

# Test set size (0.2 = 20% des données)
ML_TEST_SIZE=0.2

# Validation set size (0.15 = 15% des données)
ML_VAL_SIZE=0.15

# Early stopping patience (epochs sans amélioration)
ML_EARLY_STOPPING_PATIENCE=10

# Batch size pour modèles deep learning
ML_BATCH_SIZE=32

# Max iterations pour optimiseurs
ML_MAX_ITER=1000

# Device pour ML: cpu, cuda, mps (Apple Silicon)
MODEL_DEVICE=cpu

# ============================================================================
# FEATURE ENGINEERING
# ============================================================================

# Fenêtres pour indicateurs techniques (en jours)
TECHNICAL_WINDOWS=20,50,200

# Fenêtres pour calcul momentum (en jours)
MOMENTUM_WINDOWS=1,5,20,60,252

# Lag features (retards en jours)
LAG_PERIODS=1,5,10,20

# Rolling windows pour statistiques (en jours)
ROLLING_WINDOWS=5,10,20,60

# ============================================================================
# BACKTESTING CONFIGURATION
# ============================================================================

# Période de warmup (jours de données nécessaires avant premier trade)
WARMUP_PERIOD=252

# Fréquence de rebalancing
# Options: 'daily', 'weekly', 'monthly', 'quarterly', 'yearly'
REBALANCING_FREQUENCY=monthly

# Jour de rebalancing (pour weekly/monthly)
# weekly: 0=Monday, 4=Friday
# monthly: 1=1er du mois, -1=dernier jour
REBALANCING_DAY=1

# Benchmark pour comparaison (ticker index)
BENCHMARK_TICKER=^GSPC

# ============================================================================
# API SERVER CONFIGURATION
# ============================================================================

# Host et port pour FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# Mode debug (True/False)
API_DEBUG=False

# CORS origins autorisés (séparés par virgules)
API_CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# JWT secret key (générer avec: openssl rand -hex 32)
# API_JWT_SECRET=your_jwt_secret_key_here

# JWT expiration (en minutes)
# API_JWT_EXPIRATION=1440

# ============================================================================
# DASHBOARD CONFIGURATION
# ============================================================================

# Port Streamlit
DASHBOARD_PORT=8501

# Thème Streamlit
# Options: 'light', 'dark'
DASHBOARD_THEME=light

# Activer mode wide par défaut
DASHBOARD_WIDE_MODE=True

# Activer cache Streamlit
DASHBOARD_CACHE_ENABLED=True

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Niveau de log
# Options: 'DEBUG', 'INFO', 'WARNING', 'ERROR', 'CRITICAL'
LOG_LEVEL=INFO

# Fichier de log
LOG_FILE=logs/finbot.log

# Format de log
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Rotation logs (en MB)
LOG_MAX_SIZE=10

# Nombre de fichiers logs à conserver
LOG_BACKUP_COUNT=5

# ============================================================================
# NOTIFICATION CONFIGURATION (Optionnel)
# ============================================================================

# Email notifications (SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password_here
# EMAIL_RECIPIENT=alerts@example.com

# Slack notifications
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Telegram notifications
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ============================================================================
# DEVELOPMENT / TESTING
# ============================================================================

# Mode environnement
# Options: 'development', 'testing', 'staging', 'production'
ENVIRONMENT=development

# Activer mode test (skip API calls, use mocks)
TESTING_MODE=False

# Seed pour génération données synthétiques en test
TEST_DATA_SEED=42

# ============================================================================
# PERFORMANCE OPTIMIZATION
# ============================================================================

# Nombre de workers pour multiprocessing
N_WORKERS=4

# Taille chunk pour traitement par batch
CHUNK_SIZE=1000

# Mémoire maximale cache (en MB)
MAX_CACHE_SIZE_MB=512

# Activer compression cache
CACHE_COMPRESSION=True

# ============================================================================
# BROKER INTEGRATION (Optionnel - Trading live)
# ============================================================================

# Interactive Brokers
# IB_ACCOUNT=your_ib_account_here
# IB_HOST=127.0.0.1
# IB_PORT=7497
# IB_CLIENT_ID=1

# Alpaca
# ALPACA_API_KEY=your_alpaca_api_key_here
# ALPACA_API_SECRET=your_alpaca_api_secret_here
# ALPACA_BASE_URL=https://paper-api.alpaca.markets  # paper trading

# TD Ameritrade
# TD_API_KEY=your_td_ameritrade_api_key_here
# TD_REDIRECT_URI=https://localhost

# ============================================================================
# END OF CONFIGURATION
# ============================================================================

# ============================================================================
# API KEYS - Obtenir vos clés auprès des fournisseurs
# ============================================================================

# Financial Modeling Prep (principal pour données financières)
# Obtenir: https://financialmodelingprep.com/developer/docs/
FINANCIAL_MODELING_PREP_API_KEY=your_key_here

# Alpha Vantage (alternative/complément pour données temps réel)
# Obtenir: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_key_here

# News API (pour scraper les news financières)
# Obtenir: https://newsapi.org/
NEWS_API_KEY=your_key_here

# CoinGecko API (optionnel, pour cryptos)
# Obtenir: https://www.coingecko.com/en/api
COINGECKO_API_KEY=your_key_here

# Twitter/X API (optionnel, pour sentiment from tweets)
# Obtenir: https://developer.twitter.com/
TWITTER_API_KEY=your_key_here
TWITTER_API_SECRET=your_secret_here
TWITTER_BEARER_TOKEN=your_token_here


# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Format SQLAlchemy:
#   PostgreSQL: postgresql://user:password@localhost:5432/dbname
#   SQLite (relative): sqlite:///./finbot.db (3 slashes pour chemin relatif)
#   SQLite (absolute): sqlite:////absolute/path/to/db.db (4 slashes)
DATABASE_URL=sqlite:///./finbot.db


# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Environment: development, staging, production
ENVIRONMENT=development

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Activer/désactiver le caching des résultats (true/false)
CACHE_ENABLED=true


# ============================================================================
# MACHINE LEARNING CONFIGURATION
# ============================================================================

# Device pour ML: cpu, cuda, mps (Apple Silicon)
MODEL_DEVICE=cpu

# Batch size pour traitement des données
BATCH_SIZE=32


# ============================================================================
# TRADING CONFIGURATION
# ============================================================================

# Capital initial pour backtesting (en dollars)
INITIAL_CAPITAL=10000

# Commission par transaction (0.002 = 0.2%)
COMMISSION_RATE=0.002

# Seuil sentiment pour générer signaux (-1 à 1)
SENTIMENT_THRESHOLD=0.3


# ============================================================================
# OPTIONAL FEATURES
# ============================================================================

# Activer sentiment analysis depuis Twitter (true/false)
ENABLE_TWITTER_SENTIMENT=false

# Activer backtesting automatique (true/false)
ENABLE_AUTO_BACKTESTING=false

# Email pour notifications (optionnel)
NOTIFICATION_EMAIL=your_email@example.com
